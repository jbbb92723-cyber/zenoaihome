
# ═══════════════════════════════════════════════
# Zeno AI Home — 环境变量配置模板
# 复制此文件为 .env.local，填入真实值（.env.local 绝不提交到 git）
# ═══════════════════════════════════════════════

# ── Auth 基础 ──────────────────────────────────
AUTH_SECRET=                    # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# ── Supabase Postgres（从 Supabase 控制台 → Settings → Database 获取）──
# DATABASE_URL：使用 Supabase Pooler 连接（Transaction mode，端口 6543）
DATABASE_URL=
# DIRECT_URL：使用直连（用于 prisma db push / migrations，端口 5432）
DIRECT_URL=

# ── Supabase 私有 Storage（我的装修档案）──
# 数据库迁移、private bucket、密钥和清理流程确认前保持 false。
RENOVATION_ARCHIVE_ENABLED=false
# Bucket 必须 private，单文件上限 10MB，MIME 只允许 text/csv 和 XLSX；代码会在签发前核验。
# service role key 只能配置在服务端，不能使用 NEXT_PUBLIC_ 前缀。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RENOVATION_ARCHIVE_BUCKET=renovation-archives
# 只有迁移过 bucket 时填写历史 bucket，逗号分隔；供旧文件清理使用。
SUPABASE_RENOVATION_ARCHIVE_ALLOWED_BUCKETS=
# 独立随机密钥，至少 32 字符：openssl rand -base64 32
RENOVATION_ARCHIVE_UPLOAD_SECRET=
# Vercel Cron 自动携带此 Bearer 密钥；至少 32 字符。
CRON_SECRET=
# 只有这个 Auth.js ADMIN 用户可以写入“Zeno 本人已审核”。优先使用不可变用户 ID。
ZENO_REVIEWER_USER_ID=
# 用户 ID 暂时无法确定时可用邮箱兜底，后续应切换为 ID。
ZENO_REVIEWER_EMAIL=

# ── Google 登录（Google Cloud Console 获取）──
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── 邮件验证码（Resend.com 获取）──
RESEND_API_KEY=
EMAIL_FROM=Zeno <noreply@zenoaihome.com>

# ── 管理员后台（独立于用户登录）──
ADMIN_PASSWORD=                 # 自定义强密码
ADMIN_SESSION_SECRET=           # openssl rand -base64 32

# ── AI Provider（按任务分开）──
# provider 可选：deepseek | zhipu | openai | custom
# 文字助手可在 DeepSeek 与 GLM-5.3 之间切换；图片固定建议使用 GLM-5V-Turbo
AI_DEFAULT_PROVIDER=deepseek
AI_PUBLIC_CHAT_PROVIDER=deepseek
AI_PUBLIC_CHAT_MODEL=deepseek-chat
AI_PUBLIC_VISION_PROVIDER=zhipu
AI_PUBLIC_VISION_MODEL=glm-5v-turbo
AI_ADMIN_DRAFT_PROVIDER=deepseek
AI_ADMIN_DRAFT_MODEL=deepseek-chat
AI_CLASSIFICATION_PROVIDER=deepseek
AI_CLASSIFICATION_MODEL=deepseek-chat

# 只填写实际启用的 Provider；密钥仅放服务端环境变量
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_DEEPSEEK_CHAT_MODEL=deepseek-chat
AI_ZHIPU_API_KEY=
AI_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_ZHIPU_CHAT_MODEL=glm-5.3
AI_ZHIPU_VISION_MODEL=glm-5v-turbo
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_CHAT_MODEL=
AI_CUSTOM_API_KEY=
AI_CUSTOM_BASE_URL=
AI_CUSTOM_CHAT_MODEL=

# ── 内容中台 / Hermes / CLI 内部 API ──
# 用于 Authorization: Bearer <token> 调用 /api/internal/*
ZENO_INTERNAL_API_TOKEN=        # openssl rand -base64 32

# ── md2wechat 排版 API ──
MD2WECHAT_BASE_URL=
MD2WECHAT_API_KEY=
MD2WECHAT_CONVERT_ENDPOINT=
MD2WECHAT_UPLOAD_ENDPOINT=

# ── 微信公众号草稿箱 ──
WECHAT_APPID=
WECHAT_APP_SECRET=
WECHAT_DEFAULT_AUTHOR=Zeno
WECHAT_DEFAULT_COVER_MEDIA_ID=

# ── 豆包图片生成（火山引擎）──
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_IMAGE_MODEL=Doubao-Seedream-5.0-lite
VOLCENGINE_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_IMAGE_PRICE_PER_IMAGE=0.22

# ── 站点 URL ──
NEXT_PUBLIC_SITE_URL=https://zenoaihome.com

# ── 人工收款（未配置时，订单页不会开放付款通知）──
# 填写真实、可公开访问的微信/支付宝收款码 URL；支持站内路径或 http(s) URL
NEXT_PUBLIC_WECHAT_PAYMENT_QR_URL=
NEXT_PUBLIC_ALIPAY_PAYMENT_QR_URL=
